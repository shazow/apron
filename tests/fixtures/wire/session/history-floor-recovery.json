        { "request": { "as": "history-1", "match": { "method": "history", "params": { "room_id": "general", "after": "5", "before": "8" } } } },
        { "receive": { "method": "message", "params": { "room_id": "general", "log_id": "9", "message": { "message_id": "9", "from": { "user_id": "alice" }, "body": { "text": "live" } } } } },
        { "receive": { "method": "room", "params": { "room_id": "general", "latest_log_id": "9", "history_log_id": "5" } } },
        { "reply": { "to": "history-1", "result": { "entries": [ { "log_id": "5", "message": { "message_id": "5", "from": { "user_id": "alice" }, "body": { "text": "five" } } }, { "log_id": "6", "message": { "message_id": "6", "from": { "user_id": "alice" }, "body": { "text": "six" } } } ], "last_id": "6", "more": true, "latest_log_id": "9", "history_log_id": "5" } } },
        { "request": { "as": "history-2", "match": { "method": "history", "params": { "room_id": "general", "after": "7", "before": "8" } } } },
        { "receive": { "method": "room", "params": { "room_id": "general", "latest_log_id": "9", "history_log_id": "7" } } },
        { "reply": { "to": "history-2", "result": { "entries": [ { "log_id": "7", "message": { "message_id": "7", "from": { "user_id": "alice" }, "body": { "text": "seven" } } }, { "log_id": "8", "message": { "message_id": "8", "from": { "user_id": "alice" }, "body": { "text": "eight" } } } ], "last_id": "8", "more": false, "latest_log_id": "9", "history_log_id": "7" } } },
        { "expect": { "rooms": [ { "id": "general", "name": "general", "topic": null, "events": [ { "message_id": "7", "from": { "user_id": "alice" }, "body": { "text": "seven" } }, { "message_id": "8", "from": { "user_id": "alice" }, "body": { "text": "eight" } }, { "message_id": "9", "from": { "user_id": "alice" }, "body": { "text": "live" } } ] } ] } }
      ]
