{
  "format": 1,
  "kind": "session",
  "name": "Base history boundary recovery",
  "description": "A client tracks the inclusive retained boundary, handles empty retention, buffers live entries above a fixed head, and rebuilds when retention advances.",
  "references": [
    "PROTOCOL.md#34-rooms",
    "PROTOCOL.md#51-history"
