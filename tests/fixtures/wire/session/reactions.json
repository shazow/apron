{
  "format": 2,
  "kind": "session",
  "name": "Reactions",
  "description": "react sends the user's complete emoji set for one message and resolves on the empty result; broadcasts replace per (message_id, user_id). Reactions follow a move through the server's destination re-log, [] clears, an unknown message is invalid_params, and a tombstone hides reactions.",
  "references": [
    "PROTOCOL.md#45-reactions",
    "PROTOCOL.md#42-edit",
    "PROTOCOL.md#11-envelope-and-replies"
  ],
  "variants": [
    {
      "name": "session",
      "steps": [
        {"receive":{"method":"server","params":{"protocol":4,"auth":["guest"],"caps":["edit","rooms","reactions"]}}},
        {"request":{"as":"auth","match":{"method":"auth","params":{"scheme":"guest"}}}},
        {"reply":{"to":"auth","result":{"you":{"user_id":"guest_1"}}}},
        {"receive":{"method":"room","params":{"room_id":"general","log_id":"90","title":"General"}}},
        {"receive":{"method":"room","params":{"room_id":"95","log_id":"95","parent_room_id":"general","title":"Side"}}},
        {"receive":{"method":"message","params":{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"bob"},"body":{"text":"ship it?"}}}},
        {"react":{"as":"like","message_id":"101","emojis":["👍"]}},
        {"request":{"as":"like-request","match":{"method":"reactions","params":{"message_id":"101","emojis":["👍"]}}}},
        {"reply":{"to":"like-request","result":{}}},
        {"receive":{"method":"reactions","params":{"log_id":"102","message_id":"101","room_id":"general","reactions":[{"from":{"user_id":"guest_1"},"emojis":["👍"]}]}}},
        {"receive":{"method":"reactions","params":{"log_id":"103","message_id":"101","room_id":"general","reactions":[{"from":{"user_id":"carol"},"emojis":["🎉","👍"]}]}}},
        {"expect":{"operations":{"like":"fulfilled"},"rooms":[{"room_id":"95","log_id":"95","parent_room_id":"general","title":"Side","messages":[]},{"room_id":"general","log_id":"90","title":"General","messages":[{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"bob"},"body":{"text":"ship it?"},"reactions":[{"emoji":"🎉","user_ids":["carol"]},{"emoji":"👍","user_ids":["carol","guest_1"]}]}]}]}},
        {"react":{"as":"change","message_id":"101","emojis":["👀"]}},
        {"request":{"as":"change-request","match":{"method":"reactions","params":{"message_id":"101","emojis":["👀"]}}}},
        {"receive":{"method":"reactions","params":{"log_id":"104","message_id":"101","room_id":"general","reactions":[{"from":{"user_id":"guest_1"},"emojis":["👀"]}]}}},
        {"reply":{"to":"change-request","result":{}}},
        {"receive":{"method":"message","params":{"message_id":"101","log_id":"105","room_id":"95","from":{"user_id":"bob"},"body":{"text":"ship it?"}}}},
        {"receive":{"method":"reactions","params":{"log_id":"106","message_id":"101","room_id":"95","reactions":[{"from":{"user_id":"carol"},"emojis":["🎉","👍"]},{"from":{"user_id":"guest_1"},"emojis":["👀"]}]}}},
        {"expect":{"rooms":[{"room_id":"95","log_id":"95","parent_room_id":"general","title":"Side","messages":[{"message_id":"101","log_id":"105","room_id":"95","from":{"user_id":"bob"},"body":{"text":"ship it?"},"reactions":[{"emoji":"🎉","user_ids":["carol"]},{"emoji":"👀","user_ids":["guest_1"]},{"emoji":"👍","user_ids":["carol"]}]}]},{"room_id":"general","log_id":"90","title":"General","messages":[]}]}},
        {"react":{"as":"clear","message_id":"101","emojis":[]}},
        {"request":{"as":"clear-request","match":{"method":"reactions","params":{"message_id":"101","emojis":[]}}}},
        {"reply":{"to":"clear-request","result":{}}},
        {"receive":{"method":"reactions","params":{"log_id":"107","message_id":"101","room_id":"95","reactions":[{"from":{"user_id":"guest_1"},"emojis":[]}]}}},
        {"expect":{"rooms":[{"room_id":"95","log_id":"95","parent_room_id":"general","title":"Side","messages":[{"message_id":"101","log_id":"105","room_id":"95","from":{"user_id":"bob"},"body":{"text":"ship it?"},"reactions":[{"emoji":"🎉","user_ids":["carol"]},{"emoji":"👍","user_ids":["carol"]}]}]},{"room_id":"general","log_id":"90","title":"General","messages":[]}]}},
        {"react":{"as":"unknown","message_id":"999","emojis":["👍"]}},
        {"request":{"as":"unknown-request","match":{"method":"reactions","params":{"message_id":"999","emojis":["👍"]}}}},
        {"reply":{"to":"unknown-request","error":{"code":-32602,"message":"Unknown message"}}},
        {"receive":{"method":"message","params":{"message_id":"101","log_id":"108","room_id":"95","from":{"user_id":"bob"},"deleted":true}}}
      ]
    }
  ],
  "expected": {
    "you": {"user_id":"guest_1"},
    "caps": ["edit","reactions","rooms"],
    "operations": {"like":"fulfilled","change":"fulfilled","clear":"fulfilled","unknown":"rejected"},
    "rooms": [
      {"room_id":"95","log_id":"95","parent_room_id":"general","title":"Side","messages":[{"message_id":"101","log_id":"108","room_id":"95","from":{"user_id":"bob"},"deleted":true}]},
      {"room_id":"general","log_id":"90","title":"General","messages":[]}
    ]
  }
