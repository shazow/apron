            ]
          }
        },
        {
          "receive": {
            "method": "typing",
            "params": {
              "room_id": "general",
              "from": {
                "user_id": "bob",
                "name": "Bob"
              },
              "active": false
            }
          }
        },
        {
          "expect": {
            "typing": []
          }
        },
        {
          "expect": {
            "rooms": [
              {
                "id": "general",
                "name": "General",
                "topic": "Initial topic",
                "events": []
              }
            ]
          }
        },
        {
          "send": {
            "as": "message",
            "room": "general",
            "text": "hello",
            "format": "plain"
          }
        },
        {
          "request": {
            "as": "send",
            "match": {
              "method": "message",
              "params": {
                "room_id": "general",
                "body": {
                  "text": "hello",
                  "format": "plain"
                }
              }
            }
          }
        },
        {
          "reply": {
            "to": "send",
            "result": {
              "message_id": "1724803200001"
            }
          }
        },
        {
          "receive": {
            "method": "message",
            "params": {
              "room_id": "general",
              "log_id": "1724803200001",
              "message": {
                "message_id": "1724803200001",
                "from": {
                  "user_id": "alice"
                },
                "body": {
                  "text": "hello",
                  "format": "plain"
                }
              }
            }
          },
          "echoFrom": "send"
        },
        {
          "expect": {
            "rooms": [
              {
                "id": "general",
                "name": "General",
                "topic": "Initial topic",
                "events": [
                  {
                    "message_id": "1724803200001",
                    "from": {
                      "user_id": "alice"
                    },
                    "body": {
                      "text": "hello",
                      "format": "plain"
                    }
                  }
                ]
              }
            ],
            "operations": {
              "message": "fulfilled"
            }
          }
        },
        {
          "receive": {
            "method": "server",
            "params": {
              "protocol": 2,
              "auth": [
                "anonymous"
              ]
            }
          }
        },
        {
          "receive": {
            "method": "future_notice",
            "params": {
              "room_id": "general",
              "text": "not a message"
            }
          }
        },
        {
          "receive": {
            "method": "room",
            "params": {
              "room_id": "general",
              "name": "Renamed"
            }
          }
        },
        {
          "expect": {
            "caps": [],
            "rooms": [
              {
                "id": "general",
                "name": "Renamed",
                "topic": null,
                "events": [
                  {
                    "message_id": "1724803200001",
                    "from": {
                      "user_id": "alice"
                    },
                    "body": {
                      "text": "hello",
                      "format": "plain"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "receive": {
            "method": "room",
            "params": {
              "room_id": "other"
            }
          }
        },
        {
          "expect": {
            "rooms": [
              {
                "id": "general",
                "name": "Renamed",
                "topic": null,
                "events": [
                  {
                    "message_id": "1724803200001",
                    "from": {
                      "user_id": "alice"
                    },
                    "body": {
                      "text": "hello",
                      "format": "plain"
                    }
                  }
                ]
              },
              {
                "id": "other",
                "name": "other",
                "topic": null,
                "events": []
              }
            ]
          }
        },
        {
          "receive": {
            "method": "room",
            "params": {
              "room_id": "other",
              "removed": true
            }
          }
        }
      ]
