{
  "format": 1,
  "kind": "session",
  "name": "Core session and metadata replacement",
  "description": "Authenticate, send with either reply ordering, replace capabilities and room metadata, and remove a room without altering retained message state.",
  "references": [
    "PROTOCOL.md#11-envelope-and-replies",
    "PROTOCOL.md#31-server-frame",
    "PROTOCOL.md#34-rooms",
    "PROTOCOL.md#35-messages"
  ],
  "variants": [
    {
      "name": "result-before-broadcast",
      "steps": [
        {
          "receive": {
            "method": "server",
            "params": {
              "protocol": 2,
              "auth": [
                "anonymous"
              ],
              "caps": [
                "edit"
              ],
              "future_hint": {
                "ignored": true
              }
            }
          }
        },
        {
          "request": {
            "as": "auth",
            "match": {
              "method": "auth",
              "params": {
                "scheme": "anonymous"
              }
            }
          }
        },
        {
          "reply": {
            "to": "auth",
            "result": {
              "you": {
                "user_id": "alice"
              }
            }
          }
        },
        {
          "expect": {
            "you": {
              "user_id": "alice"
            }
          }
        },
        {
          "receive": {
            "method": "room",
            "params": {
              "room_id": "general",
              "name": "General",
              "topic": "Initial topic"
            }
          }
        },
        {
          "receive": {
            "method": "typing",
            "params": {
              "room_id": "general",
              "from": {
                "user_id": "bob",
                "name": "Bob"
              },
              "active": true
            }
          }
        },
        {
          "expect": {
            "typing": [
              {
                "room_id": "general",
