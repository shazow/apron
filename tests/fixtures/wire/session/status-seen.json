        {"request":{"as":"rooms","match":{"method":"room_list","params":{"filter":"joined","members":true}}}},
        {"reply":{"to":"auth","result":{"you":{"user_id":"guest_1","name":"Ada","status":"online"},"token":"st_Hk41x9"}}},
        {"receive":{"method":"user","params":{"new":{"user_id":"bob","status":"online"}}}},
        {"reply":{"to":"rooms","result":{"joined":[{"room_id":"general","log_id":"90","title":"General","members":[{"user_id":"bob"},{"user_id":"carol"},{"user_id":"guest_1"}]}],"users":[{"user_id":"bob","name":"Bob","status":"online"},{"user_id":"carol","name":"Carol","status":"offline","seen":"40"},{"user_id":"guest_1","name":"Ada","status":"online"}]}}},
        {"expect":{"users":{"bob":{"user_id":"bob","name":"Bob","status":"online"},"carol":{"user_id":"carol","name":"Carol","status":"offline"},"guest_1":{"user_id":"guest_1","name":"Ada","status":"online"}},"seen":{"carol":"40"}}},
