        {"request":{"as":"history-1","match":{"method":"history","params":{"room_id":"general","after":"105","before":"108"}}}},
        {"receive":{"method":"message","params":{"message_id":"109","log_id":"109","room_id":"general","from":{"user_id":"alice"},"body":{"text":"live"}}}},
        {"receive":{"method":"room","params":{"room_id":"general","log_id":"100","title":"General","latest_log_id":"109","history_log_id":"105"}}},
        {"reply":{"to":"history-1","result":{"entries":[{"message_id":"105","log_id":"105","room_id":"general","from":{"user_id":"alice"},"body":{"text":"five"}},{"message_id":"106","log_id":"106","room_id":"general","from":{"user_id":"alice"},"body":{"text":"six"}}],"first_id":"105","last_id":"106","more":true,"latest_log_id":"109","history_log_id":"105"}}},
