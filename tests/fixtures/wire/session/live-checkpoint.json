        {"reply":{"to":"auth","result":{"you":{"user_id":"guest_1"}}}},
        {"reply":{"to":"rooms","result":{"joined":[{"room_id":"general","log_id":"100","title":"General","latest_log_id":"101","history_log_id":"100","members":[{"user_id":"guest_1"}]}],"users":[{"user_id":"guest_1"}]}}},
        {"request":{"as":"history","match":{"method":"history","params":{"room_id":"general","after":"100","before":"101"}}}},
        {"reply":{"to":"history","result":{"rooms":[{"room_id":"general","log_id":"100","title":"General"}],"messages":[{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"guest_1"},"body":{"text":"retained","format":"plain"}}],"first_log_id":"100","last_log_id":"101","more":false,"latest_log_id":"101","history_log_id":"100"}}},
        {"expect":{"rooms":[{"room_id":"general","log_id":"100","title":"General","messages":[{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"guest_1"},"body":{"text":"retained","format":"plain"}}]}]}},
        {"receive":{"method":"message","params":{"message_id":"102","log_id":"102","room_id":"general","from":{"user_id":"bob"},"body":{"text":"live","format":"plain"}}}},
