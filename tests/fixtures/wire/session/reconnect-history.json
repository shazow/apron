{
  "format": 4,
  "kind": "session",
  "name": "Guest reconnect and retained history",
  "description": "A fresh guest identity authenticates after transport loss. The client rebuilds its protocol view from the new connection: rooms are empty until listed again. Each room's records, floor and checkpoint are kept across the loss, so the kept room's recovery resumes after its checkpoint instead of paging the whole retained range, sent right behind auth and the listing before either result (auth is a barrier) and without a head, which its page supplies; it covers message and reaction records, keeping the original sender and yielding each message once. A guest's listing is always a full one: the new identity is not the kept rooms'. This server keeps guests' memberships out of the log.",
  "references": [
    "PROTOCOL.md#32-authentication",
    "PROTOCOL.md#41-history",
    "PROTOCOL.md#45-reactions"
  ],
  "variants": [
    {
      "name": "resume-from-checkpoint",
      "steps": [
        {"receive":{"method":"server","params":{"protocol":6,"auth":["guest"],"caps":["history","rooms"]}}},
        {"request":{"as":"auth","match":{"method":"auth","params":{"scheme":"guest"}}}},
        {"request":{"as":"rooms","match":{"method":"room_list","params":{"filter":"joined","members":true}}}},
        {"reply":{"to":"auth","result":{"you":{"user_id":"guest_1"}}}},
        {"expect":{"you":{"user_id":"guest_1"}}},
        {"reply":{"to":"rooms","result":{"joined":[{"room_id":"general","log_id":"100","title":"General","latest_log_id":"101","history_log_id":"100","members":[{"user_id":"guest_1"}]}],"users":[{"user_id":"guest_1"}]}}},
        {"request":{"as":"history-before","match":{"method":"history","params":{"room_id":"general","after":"100","before":"101"}}}},
        {"reply":{"to":"history-before","result":{"rooms":[{"room_id":"general","log_id":"100","title":"General"}],"messages":[{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"guest_1"},"body":{"text":"retained","format":"plain"}}],"first_log_id":"100","last_log_id":"101","more":false,"latest_log_id":"101","history_log_id":"100"}}},
        {"expect":{"rooms":[{"room_id":"general","log_id":"100","title":"General","messages":[{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"guest_1"},"body":{"text":"retained","format":"plain"}}]}]}},
        {"receive":{"method":"message","params":{"message_id":"102","log_id":"102","room_id":"general","from":{"user_id":"bob"},"body":{"text":"while connected","format":"plain"}}}},
        {"expect":{"rooms":[{"room_id":"general","log_id":"100","title":"General","messages":[{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"guest_1"},"body":{"text":"retained","format":"plain"}},{"message_id":"102","log_id":"102","room_id":"general","from":{"user_id":"bob"},"body":{"text":"while connected","format":"plain"}}]}]}},
        {"disconnect":true},
        {"expect":{"you":null,"caps":[],"rooms":[]}},
        {"receive":{"method":"server","params":{"protocol":6,"auth":["guest"],"caps":["history","rooms"]}}},
        {"request":{"as":"auth-again","match":{"method":"auth","params":{"scheme":"guest"}}}},
        {"request":{"as":"rooms-2","match":{"method":"room_list","params":{"filter":"joined","members":true}}}},
        {"request":{"as":"history-after","match":{"method":"history","params":{"room_id":"general","after":"102"}}}},
        {"reply":{"to":"auth-again","result":{"you":{"user_id":"guest_2"}}}},
        {"expect":{"you":{"user_id":"guest_2"},"rooms":[]}},
        {"reply":{"to":"rooms-2","result":{"joined":[{"room_id":"general","log_id":"100","title":"General","latest_log_id":"104","history_log_id":"100","members":[{"user_id":"guest_2"}]}],"users":[{"user_id":"guest_2"}]}}},
        {"reply":{"to":"history-after","result":{"messages":[{"message_id":"102","log_id":"102","room_id":"general","from":{"user_id":"bob"},"body":{"text":"while connected","format":"plain"}},{"message_id":"103","log_id":"103","room_id":"general","from":{"user_id":"bob"},"body":{"text":"while away","format":"plain"}}],"reactions":[{"log_id":"104","message_id":"101","room_id":"general","reactions":[{"from":{"user_id":"carol"},"emojis":["👍"]}]}],"first_log_id":"102","last_log_id":"104","more":false,"latest_log_id":"104","history_log_id":"100"}}},
        {"expect":{"rooms":[{"room_id":"general","log_id":"100","title":"General","messages":[{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"guest_1"},"body":{"text":"retained","format":"plain"},"reactions":[{"emoji":"👍","user_ids":["carol"]}]},{"message_id":"102","log_id":"102","room_id":"general","from":{"user_id":"bob"},"body":{"text":"while connected","format":"plain"}},{"message_id":"103","log_id":"103","room_id":"general","from":{"user_id":"bob"},"body":{"text":"while away","format":"plain"}}]}]}},
        {"send":{"as":"after-reconnect","room":"general","text":"new connection","format":"plain"}},
        {"request":{"as":"send","match":{"method":"message","params":{"room_id":"general","body":{"text":"new connection","format":"plain"}}}}},
        {"receive":{"method":"message","params":{"message_id":"105","log_id":"105","room_id":"general","from":{"user_id":"guest_2"},"body":{"text":"new connection","format":"plain"}}}},
        {"reply":{"to":"send","result":{"message_id":"105"}}}
      ]
    }
  ],
  "expected": {
    "you": {"user_id":"guest_2"},
    "caps": ["history","rooms"],
    "operations": {"after-reconnect":"fulfilled"},
    "rooms": [
      {"room_id":"general","log_id":"100","title":"General","messages":[{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"guest_1"},"body":{"text":"retained","format":"plain"},"reactions":[{"emoji":"👍","user_ids":["carol"]}]},{"message_id":"102","log_id":"102","room_id":"general","from":{"user_id":"bob"},"body":{"text":"while connected","format":"plain"}},{"message_id":"103","log_id":"103","room_id":"general","from":{"user_id":"bob"},"body":{"text":"while away","format":"plain"}},{"message_id":"105","log_id":"105","room_id":"general","from":{"user_id":"guest_2"},"body":{"text":"new connection","format":"plain"}}]}
    ]
  }
}
