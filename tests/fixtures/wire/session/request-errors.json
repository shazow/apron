{
  "format": 4,
  "kind": "session",
  "name": "Request errors keep the session usable",
  "description": "Denied sends, saves, and room creations reject their operations without changing state; so do a send to a room the user cannot see (invalid_params) and a command to a server without capability command (unsupported, the reply to an unknown method). A later operation with a new request ID succeeds.",
  "references": [
    "PROTOCOL.md#1-transport--framing",
    "PROTOCOL.md#11-envelope-and-replies",
    "PROTOCOL.md#12-retries-and-deduplication",
    "PROTOCOL.md#41-command",
    "PROTOCOL.md#43-rooms",
    "PROTOCOL.md#44-edit"
  ],
  "variants": [
    {
      "name": "denied-then-accepted",
      "steps": [
        {"receive":{"method":"server","params":{"apron":8,"auth":["guest"],"capabilities":["edit","rooms"]}}},
        {"request":{"as":"auth","match":{"method":"auth","params":{"scheme":"guest"}}}},
        {"reply":{"to":"auth","result":{"you":{"user_id":"guest_7"}}}},
        {"expect":{"you":{"user_id":"guest_7"}}},
        {"request":{"as":"rooms","match":{"method":"room_list","params":{"filter":"joined","members":true}}}},
        {"reply":{"to":"rooms","result":{"joined":[{"room_id":"general","title":"General","members":[{"user_id":"guest_7"}]}],"users":[{"user_id":"guest_7"}]}}},
        {"send":{"as":"denied","room":"general","text":"denied","format":"plain"}},
        {"request":{"as":"denied-request","match":{"method":"message","params":{"room_id":"general","body":{"text":"denied","format":"plain"}}}}},
        {"reply":{"to":"denied-request","error":{"code":-32001,"message":"Denied by fixture policy"}}},
        {"expect":{"rooms":[{"room_id":"general","title":"General","messages":[]}],"operations":{"denied":"rejected"}}},
        {"send":{"as":"accepted","room":"general","text":"allowed","format":"plain"}},
        {"request":{"as":"accepted-request","match":{"method":"message","params":{"room_id":"general","body":{"text":"allowed","format":"plain"}}}}},
        {"receive":{"method":"message","params":{"message_id":"1724803200300","log_id":"1724803200300","room_id":"general","from":{"user_id":"guest_7"},"body":{"text":"allowed","format":"plain"}}}},
        {"receive":{"method":"message","params":{"message_id":"1724803200301","log_id":"1724803200301","room_id":"general","from":{"user_id":"bob"},"body":{"text":"not yours","format":"plain"}}}},
        {"reply":{"to":"accepted-request","result":{"message_id":"1724803200300"}}},
        {"editMessage":{"as":"edit-denied","message_id":"1724803200301","text":"mine now"}},
        {"request":{"as":"edit-denied-request","match":{"method":"message","params":{"message_id":"1724803200301","room_id":"general","body":{"text":"mine now","format":"plain"}}}}},
        {"reply":{"to":"edit-denied-request","error":{"code":-32001,"message":"Only the author may edit"}}},
        {"createRoom":{"as":"room-denied","title":"Mine"}},
        {"request":{"as":"room-denied-request","match":{"method":"room_set","params":{"title":"Mine"}}}},
        {"reply":{"to":"room-denied-request","error":{"code":-32001,"message":"Only threads may be created"}}},
        {"send":{"as":"hidden","room":"secret","text":"psst","format":"plain"}},
        {"request":{"as":"hidden-request","match":{"method":"message","params":{"room_id":"secret","body":{"text":"psst","format":"plain"}}}}},
        {"reply":{"to":"hidden-request","error":{"code":-32602,"message":"No such room"}}},
        {"command":{"as":"unsupported","room":"general","text":"/kick @bob","mentions":["bob"]}},
        {"request":{"as":"unsupported-request","match":{"method":"command","params":{"room_id":"general","body":{"text":"/kick @bob","mentions":["bob"]}}}}},
        {"reply":{"to":"unsupported-request","error":{"code":-32601,"message":"Unsupported method"}}},
        {"send":{"as":"after","room":"general","text":"still here","format":"plain"}},
        {"request":{"as":"after-request","match":{"method":"message","params":{"room_id":"general","body":{"text":"still here","format":"plain"}}}}},
        {"receive":{"method":"message","params":{"message_id":"1724803200302","log_id":"1724803200302","room_id":"general","from":{"user_id":"guest_7"},"body":{"text":"still here","format":"plain"}}}},
        {"reply":{"to":"after-request","result":{"message_id":"1724803200302"}}}
      ]
    }
  ],
  "expected": {
    "you": {"user_id":"guest_7"},
    "capabilities": ["edit","rooms"],
    "rooms": [
      {"room_id":"general","title":"General","messages":[{"message_id":"1724803200300","log_id":"1724803200300","room_id":"general","from":{"user_id":"guest_7"},"body":{"text":"allowed","format":"plain"}},{"message_id":"1724803200301","log_id":"1724803200301","room_id":"general","from":{"user_id":"bob"},"body":{"text":"not yours","format":"plain"}},{"message_id":"1724803200302","log_id":"1724803200302","room_id":"general","from":{"user_id":"guest_7"},"body":{"text":"still here","format":"plain"}}]}
    ],
    "operations": {"denied":"rejected","accepted":"fulfilled","edit-denied":"rejected","room-denied":"rejected","hidden":"rejected","unsupported":"rejected","after":"fulfilled"}
  }
}
