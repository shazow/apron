{
  "format": 3,
  "kind": "session",
  "name": "Room membership",
  "description": "With cap rooms the visible rooms are the joined set: room_list with only_joined after authentication (threads included), then room_update. listRooms asks for rooms not joined; joinRoom and leaveRoom send only room_id and settle on {}, while the room itself comes and goes by room_update joined and left, which also covers being removed. An updated record of a thread not joined is not visible.",
  "references": [
    "PROTOCOL.md#34-rooms",
    "PROTOCOL.md#431-listing",
    "PROTOCOL.md#432-membership",
    "PROTOCOL.md#433-updates"
  ],
  "variants": [
    {
      "name": "join-and-leave",
      "steps": [
        {"receive":{"method":"server","params":{"protocol":5,"auth":["guest"],"caps":["rooms"]}}},
        {"request":{"as":"auth","match":{"method":"auth","params":{"scheme":"guest"}}}},
        {"reply":{"to":"auth","result":{"you":{"user_id":"guest_1"}}}},
        {"request":{"as":"rooms","match":{"method":"room_list","params":{"only_joined":true}}}},
        {"reply":{"to":"rooms","result":{"joined":[{"room_id":"102","log_id":"102","parent_room_id":"general","title":"Deploy","latest_log_id":"102"},{"room_id":"general","log_id":"90","title":"General","latest_log_id":"90","member_count":2}]}}},
        {"expect":{"rooms":[{"room_id":"102","log_id":"102","parent_room_id":"general","title":"Deploy","messages":[]},{"room_id":"general","log_id":"90","title":"General","messages":[]}]}},
        {"listRooms":{"as":"browse"}},
        {"request":{"as":"browse-request","match":{"method":"room_list","params":{"not_joined":true}}}},
        {"reply":{"to":"browse-request","result":{"rooms":[{"room_id":"ops","log_id":"95","title":"Ops","latest_log_id":"95","member_count":1}]}}},
        {"expect":{"directory":["ops"],"operations":{"browse":"fulfilled"}}},
        {"joinRoom":{"as":"join","room":"ops"}},
        {"request":{"as":"join-request","match":{"method":"room_join","params":{"room_id":"ops"}}}},
        {"reply":{"to":"join-request","result":{}}},
        {"receive":{"method":"room_update","params":{"joined":[{"room_id":"ops","log_id":"95","title":"Ops","latest_log_id":"95","member_count":2}]}}},
        {"expect":{"rooms":[{"room_id":"102","log_id":"102","parent_room_id":"general","title":"Deploy","messages":[]},{"room_id":"general","log_id":"90","title":"General","messages":[]},{"room_id":"ops","log_id":"95","title":"Ops","messages":[]}],"operations":{"browse":"fulfilled","join":"fulfilled"}}},
        {"receive":{"method":"room_update","params":{"updated":[{"room_id":"110","log_id":"110","parent_room_id":"general","title":"Incident","latest_log_id":"110"}]}}},
        {"receive":{"method":"message","params":{"message_id":"111","log_id":"111","room_id":"general","from":{"user_id":"bob"},"body":{"text":"see the incident thread"}}}},
        {"leaveRoom":{"as":"leave","room":"102"}},
        {"request":{"as":"leave-request","match":{"method":"room_leave","params":{"room_id":"102"}}}},
        {"reply":{"to":"leave-request","result":{}}},
        {"receive":{"method":"room_update","params":{"left":[{"room_id":"102"}]}}},
        {"expect":{"rooms":[{"room_id":"general","log_id":"90","title":"General","messages":[{"message_id":"111","log_id":"111","room_id":"general","from":{"user_id":"bob"},"body":{"text":"see the incident thread"}}]},{"room_id":"ops","log_id":"95","title":"Ops","messages":[]}]}},
        {"receive":{"method":"room_update","params":{"left":[{"room_id":"general"}]}}}
      ]
    }
  ],
  "expected": {
    "you": {"user_id":"guest_1"},
    "caps": ["rooms"],
    "rooms": [
      {"room_id":"ops","log_id":"95","title":"Ops","messages":[]}
    ],
    "operations": {"browse":"fulfilled","join":"fulfilled","leave":"fulfilled"}
  }
}
