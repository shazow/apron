        {"expect":{"you":{"user_id":"ada","name":"Ada"},"rooms":[{"room_id":"general","log_id":"10","title":"General","messages":[{"message_id":"11","log_id":"11","room_id":"general","from":{"user_id":"bob","name":"Bob"},"body":{"text":"one"}},{"message_id":"12","log_id":"12","room_id":"general","from":{"user_id":"bob","name":"Bob"},"body":{"text":"two"}},{"message_id":"13","log_id":"13","room_id":"general","from":{"user_id":"bob","name":"Bob"},"body":{"text":"three"}}]},{"room_id":"new","log_id":"30","title":"New","messages":[]}],"members":{"general":["ada","bob","carol"],"new":["ada"]}}}
