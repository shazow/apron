{
  "format": 4,
  "kind": "session",
  "name": "Writes and user notifications merge ext",
  "description": "With capability ext, the server keeps the ext that clients write, and writes merge it one level down, so a write that leaves ext out keeps the server's ext. The client builds an edit and a room_set from records without ext; before their own snapshot and record arrive, another writer (a bridge) adds ext, and the server keeps it in the result of the save. The client installs the snapshots and records whole. User notifications merge ext the same way: a key with an empty value clears only that key (kept as the empty value, as at the top level), and keys that a notification leaves out stay. The variant does not decide whether the client would send ext back, since its records have none when it builds the requests.",
  "references": [
    "PROTOCOL.md#33-identity",
    "PROTOCOL.md#434-creating-and-editing",
    "PROTOCOL.md#44-edit",
    "PROTOCOL.md#412-ext"
  ],
  "variants": [
    {
      "name": "concurrent-ext",
      "steps": [
        {"receive":{"method":"server","params":{"apron":8,"auth":["guest"],"capabilities":["edit","ext","rooms"]}}},
        {"request":{"as":"auth","match":{"method":"auth","params":{"scheme":"guest"}}}},
        {"request":{"as":"rooms","match":{"method":"room_list","params":{"filter":"joined","members":true}}}},
        {"reply":{"to":"auth","result":{"you":{"user_id":"guest_1","name":"Ada","ext":{"a":1,"b":2}}}}},
        {"reply":{"to":"rooms","result":{"joined":[{"room_id":"general","log_id":"90","title":"General","members":[{"user_id":"bob"},{"user_id":"guest_1"}]}],"users":[{"user_id":"bob","name":"Bob"},{"user_id":"guest_1","name":"Ada","ext":{"a":1,"b":2}}]}}},
        {"receive":{"method":"message","params":{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"guest_1","name":"Ada"},"body":{"text":"draft","format":"plain"}}}},
        {"expect":{"rooms":[{"room_id":"general","log_id":"90","title":"General","messages":[{"message_id":"101","log_id":"101","room_id":"general","from":{"user_id":"guest_1","name":"Ada"},"body":{"text":"draft","format":"plain"}}]}],"users":{"bob":{"user_id":"bob","name":"Bob"},"guest_1":{"user_id":"guest_1","name":"Ada","ext":{"a":1,"b":2}}}}},
        {"editMessage":{"as":"edit","message_id":"101","text":"final"}},
        {"request":{"as":"edit-request","match":{"method":"message","params":{"message_id":"101","room_id":"general","body":{"text":"final","format":"plain"}}}}},
        {"receive":{"method":"message","params":{"message_id":"101","log_id":"102","room_id":"general","from":{"user_id":"guest_1","name":"Ada"},"body":{"text":"draft","format":"plain"},"ext":{"irc":{"msgid":"a1b2"}}}}},
        {"receive":{"method":"message","params":{"message_id":"101","log_id":"103","room_id":"general","from":{"user_id":"guest_1","name":"Ada"},"body":{"text":"final","format":"plain"},"ext":{"irc":{"msgid":"a1b2"}},"prev_log_id":"102"}}},
        {"reply":{"to":"edit-request","result":{"message_id":"101"}}},
        {"expect":{"operations":{"edit":"fulfilled"},"rooms":[{"room_id":"general","log_id":"90","title":"General","messages":[{"message_id":"101","log_id":"103","room_id":"general","from":{"user_id":"guest_1","name":"Ada"},"body":{"text":"final","format":"plain"},"ext":{"irc":{"msgid":"a1b2"}}}]}]}},
        {"updateRoom":{"as":"rename","room":"general","title":"General (ops)"}},
        {"request":{"as":"rename-request","match":{"method":"room_set","params":{"room_id":"general","title":"General (ops)"}}}},
        {"receive":{"method":"room_update","params":{"updated":[{"room_id":"general","log_id":"104","prev_log_id":"90","title":"General","ext":{"irc":{"channel":"#general"}}}]}}},
        {"receive":{"method":"room_update","params":{"updated":[{"room_id":"general","log_id":"105","prev_log_id":"104","title":"General (ops)","ext":{"irc":{"channel":"#general"}}}]}}},
        {"reply":{"to":"rename-request","result":{"room_id":"general"}}},
        {"expect":{"operations":{"edit":"fulfilled","rename":"fulfilled"},"rooms":[{"room_id":"general","log_id":"105","title":"General (ops)","ext":{"irc":{"channel":"#general"}},"messages":[{"message_id":"101","log_id":"103","room_id":"general","from":{"user_id":"guest_1","name":"Ada"},"body":{"text":"final","format":"plain"},"ext":{"irc":{"msgid":"a1b2"}}}]}]}},
        {"receive":{"method":"user","params":{"you":{"user_id":"guest_1","ext":{"a":""}}}}},
        {"receive":{"method":"user","params":{"new":{"user_id":"bob","ext":{"irc":{"nick":"bob_"}}}}}},
        {"receive":{"method":"user","params":{"new":{"user_id":"bob","ext":{"matrix":{"mxid":"@bob:example.org"}}}}}}
      ]
    }
  ],
  "expected": {
    "you": {"user_id":"guest_1","name":"Ada","ext":{"a":"","b":2}},
    "capabilities": ["edit","ext","rooms"],
    "operations": {"edit":"fulfilled","rename":"fulfilled"},
    "users": {"bob":{"user_id":"bob","name":"Bob","ext":{"irc":{"nick":"bob_"},"matrix":{"mxid":"@bob:example.org"}}},"guest_1":{"user_id":"guest_1","name":"Ada","ext":{"a":"","b":2}}},
    "rooms": [
      {"room_id":"general","log_id":"105","title":"General (ops)","ext":{"irc":{"channel":"#general"}},"messages":[{"message_id":"101","log_id":"103","room_id":"general","from":{"user_id":"guest_1","name":"Ada"},"body":{"text":"final","format":"plain"},"ext":{"irc":{"msgid":"a1b2"}}}]}
    ]
  }
}
