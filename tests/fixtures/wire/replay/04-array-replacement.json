              }
            }
          }
        }
      ]
    }
  ],
  "expected": {
    "events": [
      {
        "event_id": "300",
        "sender": {"id": "alice"},
        "body": {
          "text": "attachments",
          "format": "markdown",
          "embeds": [{"kind": "video", "url": "https://example.test/new.mp4"}]
