              "set": {
                "body": {"text": "after", "meta": {"nested": {"two": 3, "three": 4}}},
                "labels": {"flags": {"b": null}}
              }
            }
          }
        }
      ]
    }
  ],
  "expected": {
    "events": [
      {
        "event_id": "100",
        "sender": {"id": "alice", "name": "Alice"},
        "body": {
          "text": "after",
          "format": "plain",
          "meta": {"keep": "yes", "nested": {"one": 1, "two": 3, "three": 4}},
